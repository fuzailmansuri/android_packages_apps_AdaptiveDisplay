android_app {
    name: "AdaptiveDisplay",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    privileged: true,
    manifest: "AndroidManifest.xml",
    system_ext_specific: true,
    optimize: {
        enabled: false,
    },
    certificate: "platform",
}
